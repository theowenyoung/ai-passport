# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# Blog Cards: LVGL allocates from the system heap instead of a fixed 24 KB pool,
# because long cards create many labels. The GB2312 fonts exceed 1 MB of glyph
# bitmaps each, which needs the large font-descriptor format.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_USE_FONT_PLACEHOLDER=y

# --- Buttons ---
# Blog Cards opens its menu with a long OK press; 700 ms feels responsive.
CONFIG_BUTTON_LONG_PRESS_TIME_MS=700

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# --- Bootloader ---
# Blog Cards wakes from deep sleep on every key press. A cold boot still checks
# the whole 5 MB image; a deep-sleep wake starts the partition that was checked
# then instead of hashing it again, which saves about 0.8 s. No Secure Boot.
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y

# --- Radio ---
# Blog Cards never uses Bluetooth or Wi-Fi; content arrives over USB.
CONFIG_BT_ENABLED=n
